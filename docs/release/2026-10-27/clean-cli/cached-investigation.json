  "hypotheses": [
    {
      "draft": {
        "id": "H1",
        "title": "Status check and fulfilment insert are not atomic for duplicate deliveries",
        "mechanism": "The handler reads the payment and order status, awaits the provider, and only then inserts the fulfilment. Concurrent copies of the same event can all pass the status check before any of them commits, producing more than one fulfilment.",
        "mechanism_kind": "check_then_act_race",
        "citations": [
          {
            "file": "razorpay_ref/vulnerable/handler.py",
            "line_start": 54,
            "line_end": 97,
            "quote": "\"SELECT status, amount, currency FROM payments WHERE id = ? AND order_id = ?\","
          }
        ],
        "predicted_failure": {
          "check": "INV-1@1",
          "kind": "duplicate_fulfilment",
          "role": "order:A"
        },
        "scenarios": [
          {
            "template_id": "S3",
            "params": {
              "copies": 3,
              "fault": "rendezvous",
              "latency_ms": 200
            }
          }
        ]
      },
